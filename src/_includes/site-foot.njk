{#- The foot of every page: what the site is, beside where else to go, in columns: the apps and the
    player (site.js), the guides, and where the source is. Under them what the page says of itself
    where it says something (`footNote`, captured before the include with
    {% set footNote %}…{% endset %}), the notice H5P's name needs, and where to fix the page: its
    source here, and the issues of what it is about (`footIssues`, else this site's). -#}
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-main">
      <div class="foot-about">
        <a class="brand" href="/">
          <img src="/assets/logo.svg" alt="" width="32" height="32">
          <span class="brand-text"><span class="brand-name">{{ site.name }}</span> <span class="brand-tagline">{{ site.tagline }}</span></span>
        </a>
        <p>Free and open source, MIT. No sign-up, and no server of ours between you and your files.</p>
      </div>
      <nav class="footer-links" aria-label="Site">
        <div>
          <h2>Apps</h2>
          <ul role="list">
            {%- for app in site.apps %}
            <li><a href="{{ app.links[0].href }}">{{ app.name }}</a></li>
            {%- endfor %}
            <li><a href="{{ site.guides }}/h5p/build/">Build page</a></li>
          </ul>
        </div>
        <div>
          <h2>The player</h2>
          <ul role="list">
            {%- for link in site.player.links %}
            <li><a href="{{ link.href }}">{{ link.text }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <div>
          <h2>Guides</h2>
          <ul role="list">
            <li><a href="{{ site.guides }}/h5p/create-with-ai/">Create H5P content with AI</a></li>
            <li><a href="{{ site.guides }}/h5p/create-with-ai/#install">Give your chat the h5p-author skill</a></li>
          </ul>
        </div>
        <div>
          <h2>Open source</h2>
          <ul role="list">
            <li><a href="{{ site.github }}">GitHub</a></li>
            <li><a href="{{ site.github }}/website">This site's source</a></li>
            <li><a href="{{ site.support }}">Support development</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="foot-base">
      {%- if footNote %}
      {{ footNote | safe }}
      {%- endif %}
      <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/support/">Support</a></p>
      <p>Not affiliated with H5P Group; H5P is a registered trademark of H5P Group AS.</p>
      <p>Found a mistake? <a href="{{ site.github }}/website/edit/main/{{ page.inputPath | replace('./', '') }}">Edit this page</a> or <a href="{{ footIssues or (site.github ~ '/website/issues') }}">open an issue</a>.</p>
    </div>
  </div>
</footer>
